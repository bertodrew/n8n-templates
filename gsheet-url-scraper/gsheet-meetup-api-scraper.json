    {
      "parameters": {
        "jsCode": "// Format Meetup API event data\nconst event = $input.item.json;\nconst searchContext = $('Rate Limit (1s)').item.json;\n\n// Extract venue information\nlet venueInfo = 'Online';\nlet venueAddress = '';\nlet venueName = '';\n\nif (event.venue) {\n  venueName = event.venue.name || '';\n  venueAddress = [\n    event.venue.address_1,\n    event.venue.city,\n    event.venue.state,\n    event.venue.zip\n  ].filter(Boolean).join(', ');\n  venueInfo = venueAddress || venueName || 'Online';\n}\n\n// Format date\nconst eventDate = new Date(event.time);\nconst formattedDate = eventDate.toLocaleDateString('en-US', {\n  weekday: 'long',\n  year: 'numeric',\n  month: 'long',\n  day: 'numeric',\n  hour: '2-digit',\n  minute: '2-digit'\n});\n\n// Calculate RSVP status\nconst spotsLeft = (event.rsvp_limit || 999) - (event.yes_rsvp_count || 0);\nconst rsvpStatus = event.rsvp_limit \n  ? `${spotsLeft} spots left of ${event.rsvp_limit}`\n  : `${event.yes_rsvp_count || 0} attending`;\n\nreturn {\n  json: {\n    event_id: event.id,\n    event_name: event.name,\n    event_url: event.link,\n    event_date: formattedDate,\n    event_timestamp: event.time,\n    duration_hours: ((event.duration || 0) / 3600000).toFixed(1),\n    \n    group_name: event.group?.name || '',\n    group_url: event.group?.link || '',\n    group_members: event.group?.members || 0,\n    \n    venue_name: venueName,\n    venue_address: venueAddress,\n    location: venueInfo,\n    is_online: !event.venue || event.group?.is_simpleEvents || false,\n    \n    rsvp_count: event.yes_rsvp_count || 0,\n    rsvp_limit: event.rsvp_limit || 'Unlimited',\n    rsvp_status: rsvpStatus,\n    waitlist_count: event.waitlist_count || 0,\n    \n    description_preview: (event.description || '').replace(/<[^>]*>/g, ' ').substring(0, 500) + '...',\n    \n    search_location: searchContext.location,\n    search_topic: searchContext.topicName,\n    search_radius_miles: searchContext.radius,\n    \n    fetched_at: new Date().toISOString()\n  }\n};"
      },
