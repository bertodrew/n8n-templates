    {
      "parameters": {
        "jsCode": "// Map topic names to Meetup category IDs\n// Full list: https://www.meetup.com/api/schema/#topic-category-id\nconst topicCategoryMap = {\n  'arts': 1,\n  'book clubs': 2,\n  'career': 3,\n  'cars': 4,\n  'community': 5,\n  'dancing': 6,\n  'education': 7,\n  'fashion': 8,\n  'fitness': 9,\n  'food': 10,\n  'games': 11,\n  'health': 13,\n  'hobbies': 14,\n  'language': 16,\n  'lgbtq': 12,\n  'lifestyle': 15,\n  'movies': 17,\n  'music': 18,\n  'new age': 19,\n  'outdoors': 20,\n  'paranormal': 21,\n  'parents': 22,\n  'pets': 23,\n  'photography': 24,\n  'politics': 25,\n  'religion': 26,\n  'sci-fi': 27,\n  'singles': 28,\n  'socializing': 29,\n  'sports': 30,\n  'support': 31,\n  'technology': 34,\n  'tech': 34,\n  'ai': 34,\n  'artificial intelligence': 34,\n  'machine learning': 34,\n  'software': 34,\n  'programming': 34,\n  'web development': 34,\n  'blockchain': 34,\n  'cryptocurrency': 34,\n  'writing': 36\n};\n\nconst locations = $('Read Locations from Sheet').all().map(item => {\n  const loc = item.json.location || item.json.Location || Object.values(item.json)[0];\n  const lat = item.json.latitude || item.json.lat || item.json.Latitude;\n  const lon = item.json.longitude || item.json.lon || item.json.lng || item.json.Longitude;\n  const radius = item.json.radius || item.json.Radius || 25;\n  \n  return {\n    location: loc,\n    latitude: parseFloat(lat),\n    longitude: parseFloat(lon),\n    radius: parseInt(radius)\n  };\n}).filter(loc => loc.latitude && loc.longitude);\n\nconst topics = $('Read Topics from Sheet').all().map(item => {\n  const topicName = (item.json.topic || item.json.Topic || Object.values(item.json)[0]).toLowerCase().trim();\n  const categoryId = topicCategoryMap[topicName] || 34; // Default to technology\n  \n  return {\n    topicName: topicName,\n    categoryId: categoryId\n  };\n}).filter(topic => topic.topicName);\n\n// Create combinations of locations and topics\nconst searchCombinations = [];\n\nfor (const location of locations) {\n  for (const topic of topics) {\n    searchCombinations.push({\n      location: location.location,\n      latitude: location.latitude,\n      longitude: location.longitude,\n      radius: location.radius,\n      topicName: topic.topicName,\n      topicCategoryId: topic.categoryId\n    });\n  }\n}\n\nreturn searchCombinations.map(combo => ({ json: combo }));"
      },
